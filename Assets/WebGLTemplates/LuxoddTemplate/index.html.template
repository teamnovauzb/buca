<!DOCTYPE html>
<html lang="en-us">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
	<meta name="viewport" content="width=device-width, height=device-height, initial-scale=1, viewport-fit=cover, user-scalable=no">
    <title>Unity WebGL Player | {{{ PRODUCT_NAME }}}</title>
    <link rel="shortcut icon" href="TemplateData/favicon.ico">
    <link rel="stylesheet" href="TemplateData/style.css">
    <link rel="manifest" href="manifest.webmanifest">
	<script>
  function LuxoddApplyVisualViewportSize() {
    const vv = window.visualViewport;

    // Round outward so fractional visual-viewport pixels cannot leave a thin
    // uncovered strip on high-DPI or zoomed displays.
    const cssW = Math.max(1, Math.ceil(vv ? vv.width : window.innerWidth));
    const cssH = Math.max(1, Math.ceil(vv ? vv.height : window.innerHeight));

    const offX = Math.floor(vv ? vv.offsetLeft : 0);
    const offY = Math.floor(vv ? vv.offsetTop : 0);

    const container = document.querySelector("#unity-container");
    const canvas = document.querySelector("#unity-canvas");
    if (!container || !canvas) return;

    container.style.left = offX + "px";
    container.style.top = offY + "px";
    container.style.right = "auto";
    container.style.bottom = "auto";
    container.style.width = cssW + "px";
    container.style.height = cssH + "px";

    canvas.style.width = cssW + "px";
    canvas.style.height = cssH + "px";

    const dpr = window.devicePixelRatio || 1;
    const pxW = Math.ceil(cssW * dpr);
    const pxH = Math.ceil(cssH * dpr);

    if (canvas.width !== pxW) canvas.width = pxW;
    if (canvas.height !== pxH) canvas.height = pxH;
  }

  function LuxoddInstallViewportHandlers() {
    if (window.__luxoddViewportHandlersInstalled) return;
    window.__luxoddViewportHandlersInstalled = true;

    const apply = () => LuxoddApplyVisualViewportSize();

    window.addEventListener("resize", apply);
    window.addEventListener("orientationchange", apply);

    if (window.visualViewport) {
      window.visualViewport.addEventListener("resize", apply);
      window.visualViewport.addEventListener("scroll", apply);
    }

    apply();
    setTimeout(apply, 0);
    setTimeout(apply, 200);
    setTimeout(apply, 500);
  }


  function LuxoddForceApplyViewportAfterUnityStart() {
    const apply = () => LuxoddApplyVisualViewportSize();

    apply();
    setTimeout(apply, 0);
    setTimeout(apply, 100);
    setTimeout(apply, 250);
    setTimeout(apply, 500);
    setTimeout(apply, 1000);
  }
</script>

  </head>
  <body>
    <div id="unity-container">
      <canvas id="unity-canvas" width={{{ WIDTH }}} height={{{ HEIGHT }}} tabindex="-1"></canvas>
      <div id="unity-loading-bar">
        <div id="unity-logo"></div>
        <div id="unity-progress-bar-empty">
          <div id="unity-progress-bar-full"></div>
        </div>
      </div>
      <div id="unity-warning"> </div>
    </div>

<script>
  const pluginVersion = "{{PLUGIN_VERSION}}";
</script>
	
    <script>
      // Older builds installed a permanent cache-first service worker. Its
      // cache name did not change between uploads, so Luxodd could keep
      // serving an obsolete build. Clear only this game's legacy caches and
      // do not install another service worker inside the arcade embed.
      async function LuxoddClearLegacyBuildCaches() {
        if (!("caches" in window)) return;

        try {
          const cacheNames = await caches.keys();
          const legacyPrefix = "DefaultCompany-RealBuca-";
          await Promise.all(
            cacheNames
              .filter((name) => name.startsWith(legacyPrefix))
              .map((name) => caches.delete(name))
          );
        } catch (error) {
          console.warn("[Luxodd] Could not clear a legacy WebGL cache.", error);
        }
      }

      LuxoddClearLegacyBuildCaches();

      var container = document.querySelector("#unity-container");
      var canvas = document.querySelector("#unity-canvas");
	  LuxoddInstallViewportHandlers();
      var loadingBar = document.querySelector("#unity-loading-bar");
      var progressBarFull = document.querySelector("#unity-progress-bar-full");
      var warningBanner = document.querySelector("#unity-warning");

      // Shows a temporary message banner/ribbon for a few seconds, or
      // a permanent error message on top of the canvas if type=='error'.
      // If type=='warning', a yellow highlight color is used.
      // Modify or remove this function to customize the visually presented
      // way that non-critical warnings and error messages are presented to the
      // user.
      function unityShowBanner(msg, type) {
        function updateBannerVisibility() {
          warningBanner.style.display = warningBanner.children.length ? 'block' : 'none';
        }
        var div = document.createElement('div');
        div.textContent = msg;
        warningBanner.appendChild(div);
        if (type == 'error') div.style = 'background: red; padding: 10px;';
        else {
          if (type == 'warning') div.style = 'background: yellow; padding: 10px;';
          setTimeout(function() {
            warningBanner.removeChild(div);
            updateBannerVisibility();
          }, 5000);
        }
        updateBannerVisibility();
      }

      var buildUrl = "Build";
      var loaderUrl = buildUrl + "/{{{ LOADER_FILENAME }}}";
      var config = {
        dataUrl: buildUrl + "/{{{ DATA_FILENAME }}}",
        frameworkUrl: buildUrl + "/{{{ FRAMEWORK_FILENAME }}}",
#if USE_THREADS
        workerUrl: buildUrl + "/{{{ WORKER_FILENAME }}}",
#endif
#if USE_WASM
        codeUrl: buildUrl + "/{{{ CODE_FILENAME }}}",
#endif
#if MEMORY_FILENAME
        memoryUrl: buildUrl + "/{{{ MEMORY_FILENAME }}}",
#endif
#if SYMBOLS_FILENAME
        symbolsUrl: buildUrl + "/{{{ SYMBOLS_FILENAME }}}",
#endif
        streamingAssetsUrl: "StreamingAssets",
        companyName: {{{ JSON.stringify(COMPANY_NAME) }}},
        productName: {{{ JSON.stringify(PRODUCT_NAME) }}},
        productVersion: {{{ JSON.stringify(PRODUCT_VERSION) }}},
        showBanner: unityShowBanner,
      };

      // By default Unity keeps WebGL canvas render target size matched with
      // the DOM size of the canvas element (scaled by window.devicePixelRatio)
      // Set this to false if you want to decouple this synchronization from
      // happening inside the engine, and you would instead like to size up
      // the canvas DOM size and WebGL render target sizes yourself.
      config.matchWebGLToCanvasSize = false;


#if BACKGROUND_FILENAME
      canvas.style.background = "url('" + buildUrl + "/{{{ BACKGROUND_FILENAME.replace(/'/g, '%27') }}}') center / cover";
#endif
      loadingBar.style.display = "block";
	  
	  window.unityInstance = null;

      var script = document.createElement("script");
      script.src = loaderUrl;
      script.onload = () => {
        createUnityInstance(canvas, config, (progress) => {
          progressBarFull.style.width = 100 * progress + "%";
        }).then((unityInstance) => {
		  window.unityInstance = unityInstance;
		  LuxoddForceApplyViewportAfterUnityStart();
          loadingBar.style.display = "none";
        }).catch((message) => {
          console.error("[Luxodd] Unity failed to start.", message);
          loadingBar.style.display = "none";
          unityShowBanner("The game could not start. Please reload the page.", "error");
        });
      };
      script.onerror = () => {
        console.error("[Luxodd] Unity loader could not be downloaded:", loaderUrl);
        loadingBar.style.display = "none";
        unityShowBanner("The game files could not be loaded. Please reload the page.", "error");
      };
      document.body.appendChild(script);
    </script>
  </body>
</html>
